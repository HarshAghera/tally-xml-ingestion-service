{
  "name": "tally-xml-ingestion-service",
  "version": "1.0.0",
  "private": true,
  "description": "Ingests Tally XML exports and responses, persists them relationally, and exposes normalized vouchers.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "migrate": "tsx src/db/migrate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/multipart": "^9.4.0",
    "better-sqlite3": "^11.10.0",
    "fastify": "^5.12.8",
    "saxes": "^6.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
